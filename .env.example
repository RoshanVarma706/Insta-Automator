# Copy this file to `.env` and fill in your own values.
# These are server-side secrets used by the /api functions.
# They are NEVER exposed to the browser (do not add the VITE_ prefix).

# Google AI Studio (Gemini) — caption + hashtag generation
GEMINI_API_KEY=

# Cloudinary — video upload + 9:16 reframing
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Meta Graph API — Instagram Reels publishing
INSTAGRAM_ACCESS_TOKEN=

# Supabase — sources / clips / job tracking
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
