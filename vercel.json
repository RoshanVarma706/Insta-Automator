{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "vite",
  "functions": {
    "src/pages/api/webhook/route.ts": {
      "maxDuration": 60
    }
  },
  "environmentVariables": {
    "GEMINI_API_KEY": {
      "fromSecret": "GEMINI_API_KEY"
    },
    "CLOUDINARY_URL": {
      "fromSecret": "CLOUDINARY_URL"
    },
    "INSTAGRAM_ACCESS_TOKEN": {
      "fromSecret": "INSTAGRAM_ACCESS_TOKEN"
    },
    "IG_USER_ID": {
      "fromSecret": "IG_USER_ID"
    },
    "SUPABASE_URL": {
      "fromSecret": "SUPABASE_URL"
    },
    "SUPABASE_ANON_KEY": {
      "fromSecret": "SUPABASE_ANON_KEY"
    }
  }
}